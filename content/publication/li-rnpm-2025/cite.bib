 issn = {2998-4173},
 journal = {IEEE Transactions on Audio, Speech and Language Processing},
 keywords = {Feature extraction, Robustness, Convolution, Watermarking, Decoding, Discrete cosine transforms, Noise, Distortion, discrete cosine transform, error correction, Error correction, Gram–Schmidt orthogonaliza tion, inter-frame projection, Robust audio watermarking, Vectors},
