@inproceedings{liu_efficient_2023,
 abstract = {To protect the integrity and reliability of images, we propose a watermarking-based approach for identifying whether the image has been tampered with during transmission and recovering the tampered content to its original form. The tampered pixel values are treated as unknowns in our proposed method and are calculated by solving a system of equations using Gauss-Jordan elimination. The recovery data is obtained by encoding the MSB matrix with a secret key and then embedded as part of the watermark for content self-recovery. The remainder of the watermark is authentication information for localizing the forged region, which is produced by MSB and recovery information of each block. Compared with existing works, the experimental results with our method show superior recovery capability.},
 author = {Liu, Tong and Yuan, Xiaochen and Lam, Chan-Tong},
 booktitle = {2023 IEEE 11th International Conference on Information, Communication and Networks (ICICN)},
 doi = {10.1109/ICICN59530.2023.10393620},
 file = {Full Text PDF:files/1532/Liu 等 - 2023 - An Efficient Mathematical Method for Recovery of Tampered Image Content.pdf:application/pdf},
 keywords = {Reliability, Watermarking, Authentication, Encoding, tamper detection, Matrix decomposition, watermarking, self-recovery, image processing, Linear systems, Mathematical models},
 language = {en-US},
 month = {August},
 note = {TLDR: A watermarking-based approach for identifying whether the image has been tampered with during transmission and recovering the tampered content to its original form and the experimental results show superior recovery capability.},
 pages = {782--786},
 title = {An Efficient Mathematical Method for Recovery of Tampered Image Content},
 url = {https://ieeexplore.ieee.org/document/10393620/},
 urldate = {2025-05-22},
 year = {2023}
}
