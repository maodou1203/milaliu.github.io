	month = aug,
	year = {2023},
	note = {TLDR: A watermarking-based approach for identifying whether the image has been tampered with during transmission and recovering the tampered content to its original form and the experimental results show superior recovery capability.},
	keywords = {Reliability, Watermarking, Authentication, Encoding, tamper detection, Matrix decomposition, watermarking, self-recovery, image processing, Linear systems, Mathematical models},
	pages = {782--786},
	file = {Full Text PDF:files/1532/Liu 等 - 2023 - An Efficient Mathematical Method for Recovery of Tampered Image Content.pdf:application/pdf},
